{
  "$schema": "ALTER Software Technologies — Design Tokens v2.1",
  "meta": {
    "brand": "Alter Pedro",
    "company": "ALTER Software Technologies Private Limited",
    "version": "2.1.0",
    "created": "2026-08-12",
    "updated": "2026-10-02",
    "informedBy": "godaddy-v132 (motion + effect layers only; product layer is native ALTER)",
    "principle": "Alter Pedro: Notion/Apple discipline — near-monochrome base, one accent used sparingly. Never more than 3-4 accent appearances per screen. Primary CTAs default to ink, not accent.",
    "defaultMode": "light",
    "notes": "v2.1 fixes motion.patterns refs to fully-qualified token paths; splits breakpoints into product + marketing ladders; adds component state matrix; adds density modes; adds dataViz palette.",
    "legalEntity": "ALTER Software Technologies Private Limited"
  },
  "color": {
    "neutral": {
      "0": {
        "light": "#FFFFFF",
        "dark": "#0D0D0C"
      },
      "50": {
        "light": "#FAFAF8",
        "dark": "#141412"
      },
      "100": {
        "light": "#F2F2EE",
        "dark": "#1B1B18"
      },
      "200": {
        "light": "#E4E4E0",
        "dark": "#242422"
      },
      "300": {
        "light": "#D6D6D1",
        "dark": "#33332F"
      },
      "400": {
        "light": "#A3A39D",
        "dark": "#5A5A56"
      },
      "500": {
        "light": "#787873",
        "dark": "#787873"
      },
      "600": {
        "light": "#5A5A56",
        "dark": "#A3A39D"
