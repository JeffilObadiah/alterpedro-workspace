        "dark": "#E0728F"
      },
      "fill": {
        "light": "#8B1538",
        "dark": "#B01B45"
      },
      "fillHover": {
        "light": "#7A1030",
        "dark": "#C4234F"
      },
      "deep": {
        "light": "#7A1030",
        "dark": "#7A1030"
      }
    },
    "semantic": {
      "success": {
        "subtle": {
          "light": "#EAF3DE",
          "dark": "#173404"
        },
        "text": {
          "light": "#3B6D11",
          "dark": "#97C459"
        },
        "fill": {
          "light": "#3B6D11",
          "dark": "#639922"
        }
      },
      "warning": {
        "_comment": "Handles error AND warning states. Keeps wine free for brand.",
        "subtle": {
          "light": "#FBF2DF",
          "dark": "#412402"
        },
        "text": {
          "light": "#7A4E08",
          "dark": "#EF9F27"
        },
        "fill": {
