          "dark": "#A62E2E"
        }
      },
      "info": {
        "subtle": {
          "light": "#E6F1FB",
          "dark": "#042C53"
        },
        "text": {
          "light": "#185FA5",
          "dark": "#85B7EB"
        },
        "fill": {
          "light": "#185FA5",
          "dark": "#378ADD"
        }
      }
