# Build-time settings (read from the shell environment by `npm run build`; none of these is a secret).
# Production build: PRODUCTION=1 npm run build   (fails if SPRINT_PRICE or BOOKING_URL is missing/invalid)
BOOKING_URL=https://cal.com/alter-pedro-discovery
# SPRINT_PRICE=            # required when PRODUCTION=1 (the human supplies the price)
# HERO_VARIANT=A           # A (default) or B
