# Build-time settings (read from the shell environment by `npm run build`; none of these is a secret).
# Production build: PRODUCTION=1 npm run build   (fails if BOOKING_URL is missing / not cal.com)
BOOKING_URL=https://cal.com/alter-pedro-discovery
# SPRINT_PRICE=            # leave UNSET for the single-door launch (free 20-minute call only; build fails if Sprint/price/credit/Door words reach the output). Set it to show Door 2 (DEC-005)
# HERO_VARIANT=A           # A (default) or B
